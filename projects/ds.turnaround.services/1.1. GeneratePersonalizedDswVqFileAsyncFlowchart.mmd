flowchart LR

    Start(["Start: GeneratePersonalizedDswVqFileAsync<br/>(request, fileNameCompanyDetails, fileType)"]):::startend

    GetSurveyDetails["GetSurveyDetailsAsync:<br/>Get survey participation details"]:::supportmethod
    
    GenerateFile["GeneratePersonalizedDswFileAsync:<br/>Generate workbook file"]:::supportmethod
    
    GenerateFileDetail["📄 Detailed flow in:<br/>GeneratePersonalizedDswFileAsync-flowchart.mmd"]:::detaillink
    
    ExtractYear["Extract year from<br/>first survey detail"]:::dataextraction
    
    SetVersionId["Set VersionId =<br/>generatedFile.TemplateId"]:::action
    
    MakeHeaders["MakeFileUploadHeaders:<br/>Create upload headers with<br/>year, versionId, PDswId"]:::action
    
    SetDefaultFilename["Set default fileName =<br/>'PDswId.xlsx'"]:::action
    
    CheckFileType{"File Type?"}:::decision
    
    CheckSurveyCount{"Survey details<br/>count?"}:::decision
    
    SetMultiCountryFilename["Set fileName =<br/>'MC_companyDetails_VQ.xlsx'"]:::action
    
    SetSingleCountryFilename["Set fileName =<br/>'CountryCode_companyDetails_VQ.xlsx'"]:::action
    
    SetDvfFilename["Set fileName =<br/>fileNameCompanyDetails"]:::action
    
    UploadFile["FileShareService.UploadAsync:<br/>Upload file with headers"]:::fileshare
    
    ReturnResult(["Return: GeneratedPdswFileResult<br/>(Filename, FilePath)"]):::startend

    %% Main flow
    Start --> GetSurveyDetails
    GetSurveyDetails --> GenerateFile
    GenerateFile -.-> GenerateFileDetail
    GenerateFile --> ExtractYear
    ExtractYear --> SetVersionId
    SetVersionId --> MakeHeaders
    MakeHeaders --> SetDefaultFilename
    SetDefaultFilename --> CheckFileType
    
    CheckFileType -- "VqFile" --> CheckSurveyCount
    CheckSurveyCount -- "> 1" --> SetMultiCountryFilename
    CheckSurveyCount -- "= 1" --> SetSingleCountryFilename
    SetMultiCountryFilename --> UploadFile
    SetSingleCountryFilename --> UploadFile
    
    CheckFileType -- "DataValidationFile" --> SetDvfFilename
    SetDvfFilename --> UploadFile
    
    UploadFile --> ReturnResult

